NEXT_PUBLIC_REFLET_PUBLIC_KEY=
REFLET_SECRET_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=

DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
ADMIN_DISCORD_IDS=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DISCORD_WEBHOOK_URL=
# A private staff channel's webhook for moderation posts (bans, deleted comments with their text,
# edits, admin changes, ideas to review). Without it those are only in the admin panel's activity log.
DISCORD_MOD_WEBHOOK_URL=
REFLET_WEBHOOK_SECRET=

GITHUB_TOKEN=
NEXT_PUBLIC_SITE_URL=
REFLET_API_URL=

# Servers tab: the backend's public server list (sp-backend GET /ds/api/listen/public).
# Empty = http://64.226.112.204:8080/ds/api/listen/public
SERVER_STATUS_URL=

# Launcher game passes (lib/launcher.ts): an Ed25519 private key, PKCS#8 DER in base64. The game
# backend (sp-backend config.json, launcher.discordPassKey) holds the public half. Make a pair with:
# node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log('LAUNCHER_PASS_KEY='+k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('discordPassKey='+k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
LAUNCHER_PASS_KEY=

# 1 = no game pass until the player has accepted the current Terms of Service and Privacy Policy in
# the launcher (app/api/launcher/terms). This also stops launchers too old to show the terms, so turn
# it on once players have the launcher that asks. Empty = the launcher asks, the site does not insist.
LAUNCHER_TERMS_REQUIRED=

# The Discord bot's /ban and /unban (app/api/bot/bans): a shared secret, the same value as
# SITE_BOT_SECRET in the bot's .env. Empty = the route is off. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_SECRET=
# Discord roles that may /tempban from the bot and lift such a ban with /unban, but not ban until
# lifted (admins with the Bans permission only). Comma-separated; empty = the Moderator and Developer
# roles (1476337721374150668,1545601887292891136); none = nobody.
DISCORD_MODERATOR_ROLE_IDS=

# The launcher's Twitch tab (lib/twitch.ts, app/api/launcher/streams): an application from
# dev.twitch.tv/console (any OAuth redirect, e.g. http://localhost; Category: Website Integration).
# Both empty = the tab says streams are not set up. TWITCH_GAME_ID is optional: the SUPER PEOPLE
# category is looked up by name.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_GAME_ID=
